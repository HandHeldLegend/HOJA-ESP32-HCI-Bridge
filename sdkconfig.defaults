CONFIG_IDF_TARGET="esp32"

# Every board fitted so far has at least 2 MB; the GCU 1 and ProGCC 3.2 have 8 MB
CONFIG_ESPTOOLPY_FLASHSIZE_2MB=y
CONFIG_PARTITION_TABLE_SINGLE_APP=y

CONFIG_FREERTOS_HZ=1000
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# The controller needs 80 MHz at minimum, and that is plenty
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_80=y

# Controller only: the Bluetooth host runs on the RP2040
CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_ONLY=y
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=y
CONFIG_BTDM_CTRL_HCI_MODE_VHCI=y
CONFIG_BTDM_CTRL_BR_EDR_MAX_ACL_CONN=2
CONFIG_BTDM_CTRL_BR_EDR_MAX_SYNC_CONN=0
CONFIG_BTDM_CTRL_PINNED_TO_CORE_1=y
# CONFIG_BTDM_CTRL_MODEM_SLEEP is not set

# The I2C link interrupt and bridge task run on core 0, away from the controller
CONFIG_ESP_MAIN_TASK_AFFINITY_CPU0=y
